# Copy to server/.env and fill in. server/.env is git-ignored — never commit real values.
# Full reference: docs/architecture.md §9

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (Database → Connect → Drivers). Include a database name, e.g. /golden-hour
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/golden-hour?retryWrites=true&w=majority

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
PATIENT_REF_SECRET=replace-with-a-different-32-plus-random-characters

SESSION_TTL_HOURS=8
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Enables /api/dev/* (demo reset, simulated SMS inbox). Refused when NODE_ENV=production.
DEMO_MODE=true

# Routing: simulated (default, labelled in the UI) or openrouteservice (free key at openrouteservice.org).
ROUTING_PROVIDER=simulated
# ORS_API_KEY=
# Weather: simulated (default) or open-meteo (no key needed; needs outbound internet).
WEATHER_PROVIDER=simulated
SMS_PROVIDER=simulated
PROVIDER_TIMEOUT_MS=4000
ROUTE_CACHE_TTL_MIN=30
WEATHER_CACHE_TTL_MIN=15
RAIN_DELAY_MODERATE_PCT=15
RAIN_DELAY_HEAVY_PCT=35
# Simulated weather only: 0 = dry, 5 = moderate rain, 10 = heavy rain.
SIMULATED_RAIN_MM_PER_HOUR=0
ROAD_REPORT_CORRIDOR_KM=2

ESCALATION_STEPS_MIN=0,5,10,15
ALERT_BATCH_SIZE=3
ALERT_RESPONSE_WINDOW_MIN=5
DONATION_REST_DAYS=90
CONTACT_COOLDOWN_HOURS=24
VERIFICATION_DEADLINE_MIN=30
REQUIRE_SEPARATE_VERIFIER=true

LOG_LEVEL=info
